{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"ins-nfc-rollout-006\" ]",
  "redirects": [
    {
      "source": "/insurance",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/insurance/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
