# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# CMS raw downloads (~2GB) and optional full PPEF NPI index (~33MB)
/cms-data/**
!/cms-data/README.md
/lib/insurance/cms/data/ppef-active-npis.json

# Florida DFS bulk CSVs (hundreds of MB) — never commit
/data/dfs-raw/**
!/data/dfs-raw/README.md
/data/tdi-raw/**
!/data/tdi-raw/README.md
/data/tx-raw/**
!/data/tx-raw/README.md
/data/nj-raw/**
!/data/nj-raw/README.md
/data/ohio-raw/**
!/data/ohio-raw/README.md

# Ops enrichment run logs
/scripts/output/**

# typescript
*.tsbuildinfo
next-env.d.ts

tmp/
*.png

