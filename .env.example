# Insurance Trust Hub local env (DO NOT put real secrets in git)
# Copy to .env.local (or .env.dfs.local for ops-only machines):
#   copy .env.example .env.local
#
# Load order for scripts: .env → .env.local → .env.dfs.local
# Process env already set always wins.

# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.insurancetrusthub.com

# -----------------------------------------------------------------------------
# Supabase (Dashboard → Project Settings → API)
# SUPABASE_URL is preferred by DFS import/promote scripts.
# NEXT_PUBLIC_SUPABASE_URL is used by the Next.js app.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public anon key if already used by the app
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: direct Postgres URI for seed / raw SQL (Settings → Database → URI)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Admin dashboard
# -----------------------------------------------------------------------------
ADMIN_SECRET=change-me-to-a-secure-secret

# -----------------------------------------------------------------------------
# Marketplace API (already used in production)
# Rotate every ~60 days from developer.cms.gov
# -----------------------------------------------------------------------------
MARKETPLACE_API_KEY=your-marketplace-api-key
# MARKETPLACE_API_BASE=https://marketplace.api.healthcare.gov/api/v1

# -----------------------------------------------------------------------------
# Optional email / enrichment
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Insurance Trust Hub <hello@insurancetrusthub.com>
# GOOGLE_PLACES_API_KEY=
